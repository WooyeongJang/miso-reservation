# 비즈고(인포뱅크) 문자 발송 설정 — 실제 값은 .env 에 넣고 git 에 올리지 않는다
# 둘 중 하나만 채우면 된다. 둘 다 있으면 ID/PW 방식을 쓴다.

# (A) 비즈고 v2 — 콘솔 > 연동관리에서 발급한 통합 API Key
Bizgo_KEY=

# (B) OMNI API v1 — ID + 비밀번호 (토큰은 자동 발급·갱신)
BIZGO_CLIENT_ID=
BIZGO_CLIENT_PASSWD=

# 비즈고에 사전 등록된 발신번호 (숫자만, 예 0222050551). 비어 있으면 문자를 보내지 않는다
BIZGO_FROM=

# 선택
# BIZGO_URL=https://sandbox-omni.ibapi.kr/v1/send/omni      # (B) 샌드박스 — 실제 발송 없음
# BIZGO_URL=https://sandbox-mars.ibapi.kr/api/comm/v1/send/omni   # (A) 샌드박스
# SMS_ENABLED=false     # 문자 발송 끄기
# ADMIN_KEY=miso1234    # 관리자 비밀번호
